<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="DocX" Version="1.7.0" />
      <PackageReference Include="FastReport.OpenSource" Version="2026.1.2" />
      <PackageReference Include="FastReport.OpenSource.Export.PdfSimple" Version="2026.1.2" />
      <!-- Ensure System.IO.Packaging is available at runtime for DocX and packaging APIs -->
      <PackageReference Include="System.IO.Packaging" Version="7.0.0" />
    </ItemGroup>

    <ItemGroup>
      <None Update="input\Test.fpx">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Update="input\Test.frx">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <!-- Copy the helper Python script and requirements into the output so the EXE can call them -->
      <None Include="..\pdf2docx_convert.py">
        <Link>pdf2docx_convert.py</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Include="..\requirements.txt">
        <Link>requirements.txt</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>

</Project>
