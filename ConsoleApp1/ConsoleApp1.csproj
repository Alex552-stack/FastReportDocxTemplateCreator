<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="DocumentFormat.OpenXml" Version="3.3.0" />
      <PackageReference Include="FastReport.OpenSource" Version="2026.1.2" />
      <PackageReference Include="FastReport.OpenSource.Export.PdfSimple" Version="2026.1.2" />
      <!-- Ensure System.IO.Packaging is available at runtime for DocX and packaging APIs -->
    </ItemGroup>

    <ItemGroup>
      <None Update="input\Test.fpx">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="input\Test.frx">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <!-- Copy the helper Python script and requirements into the output so the EXE can call them -->
    </ItemGroup>

</Project>
